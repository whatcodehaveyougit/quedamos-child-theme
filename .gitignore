# OS / archive cruft
.DS_Store
__MACOSX/

# Runtime caches (regenerated by WP / LiteSpeed)
/cache/
/litespeed/

# Local by Flywheel dev helpers
/mu-plugins/

# Stock WP themes (reinstallable from wp-admin)
/themes/twentytwentythree/
/themes/twentytwentyfive/

# Tasks: a personal local working area — nothing in here is shared. The folder
# skeleton (the .gitkeep files) stays in the repo so the stages exist on a fresh
# clone; their contents never get committed.
/tasks/

# Scratch git worktrees created by background agents. Transient checkouts of this
# same repo — committing them would nest a copy of the repo inside itself. The
# skills and settings alongside them in .claude/ stay tracked.
/.claude/worktrees/